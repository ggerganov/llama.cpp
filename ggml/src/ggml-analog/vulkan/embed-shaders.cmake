# Turn the SPIR-V modules of the analog compute shaders into a header of uint32_t arrays.
#
# Invoked from ggml/src/ggml-analog/CMakeLists.txt with:
#   -DSPIRV=<name1>=<path1>,<name2>=<path2>...
#   -DOUT=<path of the generated header>
#
# The modules are stored little-endian in the SPIR-V convention, so the four bytes of every word
# are reversed to get the value of the uint32_t the Vulkan loader expects.

file(WRITE ${OUT} "// generated by vulkan/embed-shaders.cmake, do not edit\n\n")

string(REPLACE "," ";" SPIRV_LIST ${SPIRV})

foreach(ENTRY ${SPIRV_LIST})
    string(REPLACE "=" ";" ENTRY_LIST ${ENTRY})
    list(GET ENTRY_LIST 0 NAME)
    list(GET ENTRY_LIST 1 PATH)

    file(READ ${PATH} SPIRV_HEX HEX)
    string(REGEX MATCHALL "........" WORDS ${SPIRV_HEX})

    list(LENGTH WORDS N_WORDS)
    math(EXPR SPIRV_BYTES "${N_WORDS} * 4")

    file(APPEND ${OUT} "// ${NAME}: ${SPIRV_BYTES} bytes\n")
    file(APPEND ${OUT} "static const uint32_t g_analog_shader_${NAME}[] = {\n")

    set(LINE "   ")
    foreach(WORD ${WORDS})
        string(SUBSTRING ${WORD} 0 2 B0)
        string(SUBSTRING ${WORD} 2 2 B1)
        string(SUBSTRING ${WORD} 4 2 B2)
        string(SUBSTRING ${WORD} 6 2 B3)

        set(LINE "${LINE} 0x${B3}${B2}${B1}${B0}u,")
        string(LENGTH "${LINE}" LINE_LEN)

        if (LINE_LEN GREATER 110)
            file(APPEND ${OUT} "${LINE}\n")
            set(LINE "   ")
        endif()
    endforeach()
    file(APPEND ${OUT} "${LINE}\n};\n\n")
endforeach()
