set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR k1om)
set(KNC_TOOLCHAIN_ROOT /usr/linux-k1om-4.7 CACHE PATH "MPSS GCC 5.1.1 installation")
set(KNC_SYSROOT /opt/mpss/3.8.6/sysroots/k1om-mpss-linux CACHE PATH "MPSS target sysroot")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES KNC_TOOLCHAIN_ROOT KNC_SYSROOT)
set(CMAKE_C_COMPILER ${KNC_TOOLCHAIN_ROOT}/bin/x86_64-k1om-linux-gcc)
set(CMAKE_CXX_COMPILER ${KNC_TOOLCHAIN_ROOT}/bin/x86_64-k1om-linux-g++)
set(CMAKE_ASM_COMPILER ${CMAKE_C_COMPILER})
execute_process(COMMAND ${CMAKE_C_COMPILER} -dumpmachine
    OUTPUT_VARIABLE knc_target OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE knc_target_status)
if (NOT knc_target_status EQUAL 0 OR NOT knc_target STREQUAL "k1om-mpss-linux")
    message(FATAL_ERROR "The MPSS compiler must target k1om-mpss-linux")
endif()
execute_process(COMMAND ${CMAKE_C_COMPILER} -print-sysroot
    OUTPUT_VARIABLE knc_compiler_sysroot OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE knc_sysroot_status)
if (NOT knc_sysroot_status EQUAL 0 OR NOT knc_compiler_sysroot STREQUAL KNC_SYSROOT)
    message(FATAL_ERROR "The MPSS compiler sysroot must match KNC_SYSROOT")
endif()
set(CMAKE_C_FLAGS_INIT "-mknc -fno-fast-math -fno-tree-vectorize -fno-tree-slp-vectorize")
set(CMAKE_CXX_FLAGS_INIT "-mknc -fno-fast-math -fno-tree-vectorize -fno-tree-slp-vectorize")
set(CMAKE_ASM_FLAGS_INIT "-mknc")
set(CMAKE_C_FLAGS_RELEASE "-O2 -DNDEBUG")
set(CMAKE_CXX_FLAGS_RELEASE "-O2 -DNDEBUG")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static-libstdc++ -static-libgcc -lrt")
set(CMAKE_FIND_ROOT_PATH ${KNC_SYSROOT})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
